# ------------------------------------------------------------
# Vitis HLS / Vivado build artifacts (regenerable, often gigabytes)
# ------------------------------------------------------------
# v++ --work_dir output (synthesis build dirs)
hls/work/
# leftover from earlier classic-Tcl attempts
hls/projects/
hls/*.log
*.jou
vivado*.jou
vitis_hls.log
.Xil/
.hls.failed
hls.app

# Licenses: node-locked and machine-specific
*.lic

# Extracted synthesis results ARE committed
!hls/reports/
!hls/reports/*.json

# ------------------------------------------------------------
# Python and Jupyter
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------
# Secrets and local tool settings
# ------------------------------------------------------------
.env
.env.*
.claude/
.vscode/
.idea/

# ------------------------------------------------------------
# Data and model weights (none are needed; torchvision caches
# pretrained weights in the user's home directory)
# ------------------------------------------------------------
data/
*.pt
*.pth
*.onnx
*.ckpt

# ------------------------------------------------------------
# LaTeX build output (compile the paper on Overleaf)
# ------------------------------------------------------------
overleaf/*.aux
overleaf/*.log
overleaf/*.out
overleaf/*.bbl
overleaf/*.blg
overleaf/*.toc
overleaf/*.fls
overleaf/*.fdb_latexmk
overleaf/*.synctex.gz
overleaf/*.pdf

# ------------------------------------------------------------
# OS and scratch
# ------------------------------------------------------------
.DS_Store
Thumbs.db
_paper.txt
