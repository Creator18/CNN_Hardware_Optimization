# ============================================================
# Vitis HLS / Vivado build artifacts — NEVER commit these
# (they are gigabytes of regenerable binary/intermediate junk)
# ============================================================
# v++ --work_dir output (synthesis build dirs)
hls/work/
# leftover from earlier classic-Tcl attempts
hls/projects/
hls/*.log
*.jou
vivado*.jou
vitis_hls.log
.Xil/
.hls.failed
hls.app

# Licenses — node-locked, machine-specific, keep out of the repo
*.lic

# Keep ONLY: kernel source, the .cfg files, the runner, and extracted report
# JSON. The extracted reports live in hls/reports/ and ARE committed.
!hls/reports/
!hls/reports/*.json

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# ------------------------------------------------------------
# Scratch
# ------------------------------------------------------------
_paper.txt
